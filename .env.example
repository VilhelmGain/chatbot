# Auth
# Generate with: openssl rand -base64 32
AUTH_SECRET=****

# Database (docker-compose provides defaults)
POSTGRES_URL=postgresql://chatbot:chatbot@localhost:5432/chatbot

# Redis (optional, for rate limiting and stream resumption)
REDIS_URL=redis://localhost:6379

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
UPLOAD_DIR=./uploads

# Rate limit for logged-in users (0 or unset = unlimited). Guests are always limited to 10/hour.
# MAX_MESSAGES_PER_HOUR=0
