# Auth
# Generate with: openssl rand -base64 32
AUTH_SECRET=****

# Database (docker-compose provides defaults)
POSTGRES_URL=postgresql://chatbot:chatbot@localhost:5432/chatbot

# Redis (optional, for rate limiting and stream resumption)
REDIS_URL=redis://localhost:6379

# AI Provider API Keys (add the ones you want to use)
OPENAI_API_KEY=****
ANTHROPIC_API_KEY=****
GOOGLE_API_KEY=****
XAI_API_KEY=****

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
UPLOAD_DIR=./uploads
