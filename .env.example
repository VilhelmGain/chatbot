# Auth (Clerk)
# Create an instance at https://dashboard.clerk.com and copy the keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Clerk hosted sign-in/up pages. Unauthenticated users are redirected here.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://your-instance.clerk.accounts.dev/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=https://your-instance.clerk.accounts.dev/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Used to encrypt provider API keys at rest (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=****

# Database (docker-compose provides defaults)
POSTGRES_URL=postgresql://chatbot:chatbot@localhost:5432/chatbot

# Redis (optional, for rate limiting and stream resumption)
REDIS_URL=redis://localhost:6379

# App
# Canonical origin used by metadata and social images. Required for production builds.
NEXT_PUBLIC_APP_URL=http://localhost:3000
UPLOAD_DIR=./uploads

# Demo mode (optional, for previewing without any external services)
# DEMO_MODE=1 runs the app with zero dependencies: in-memory database (no
# Postgres), mock AI provider (no API keys), auto-signed-in demo user (no
# Clerk), and no Redis. Deploy on Vercel with only DEMO_MODE=1 and
# NEXT_PUBLIC_APP_URL set. Do NOT set POSTGRES_URL, ENCRYPTION_KEY, Clerk, or
# Redis keys in this mode. Data is ephemeral (per-instance, resets on restart).
# DEMO_MODE=1

# Rate limit for logged-in users (0 or unset = unlimited).
# MAX_MESSAGES_PER_HOUR=0
